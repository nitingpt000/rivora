# Rivora contracts — deployment configuration.
#
# Copy to `contracts/.env` and fill in. That file is gitignored.
#
# Only needed to DEPLOY. `pnpm --filter @rivora/contracts test` needs none of
# this — the tests run against a local EVM.

# --- Network ----------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io

# --- Who controls the protocol ----------------------------------------------
# Receives DEFAULT_ADMIN_ROLE, RISK_ROLE and KEEPER_ROLE on the deployed
# contracts. Use an address you control — on testnet your own wallet is fine;
# on anything real this should be a multisig.
PROTOCOL_ADMIN=

# The only key whose signature the Risk Registry accepts on an assessment.
# Separate from the admin on purpose: the underwriting key signs continuously
# and is the more exposed of the two.
UNDERWRITER_ADDRESS=

# --- Signing the deployment -------------------------------------------------
# Two options. Pick one.
#
# 1. RECOMMENDED — Foundry keystore. The key is encrypted on disk and never
#    appears in a file or in shell history:
#
#      cast wallet import rivora-deployer --interactive
#      pnpm --filter @rivora/contracts deploy:arc -- --account rivora-deployer
#
# 2. Circle Smart Contract Platform. The key stays inside Circle and never
#    reaches this machine at all. Set these and deploy through their API
#    rather than through forge:
#
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# A raw PRIVATE_KEY variable is deliberately not offered here. A key in a
# dotenv file is one `cat` away from a screen share and one mistake away from a
# commit, and this one can move protocol funds.

# --- Optional ---------------------------------------------------------------
# Defaults to Arc's USDC precompile; override only for a local fork or a
# different network.
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
