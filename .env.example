# Rivora — build-time configuration.
#
# Copy to `.env.local` and fill in. Every variable here is `NEXT_PUBLIC_`,
# which means it is inlined into the client bundle and is readable by anyone
# who loads the app. Never put a secret behind one of these — server-only
# secrets belong in unprefixed variables read inside route handlers.
#
# All values below have working defaults, so a fresh clone runs with no .env
# file at all. Set them when pointing at a real network or backend.

# --- API -------------------------------------------------------------------
# Origin the NestJS API is served from. Required: the web app has no route
# handlers of its own, so an empty value leaves every request 404ing.
NEXT_PUBLIC_API_BASE_URL=

# --- Arc network -----------------------------------------------------------
# Chain id, RPC and explorer for the network the wallet connects to.
# Values are Arc Testnet; see https://docs.arc.io/arc/references/connect-to-arc
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app

# USDC's ERC-20 interface. A fixed precompile-style address, the same on every
# Arc network. Note the two scales: USDC is 18 decimals as the native gas token
# and 6 decimals through this interface. Protocol figures use the 6.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Circle Gateway's deposit contract, where nanopayment proceeds are held before
# a burn intent withdraws them to a recipient on Arc.
NEXT_PUBLIC_GATEWAY_WALLET_ADDRESS=0x0077777d7EBA4688BDeF3E311b846F25870A19B9

# --- Wallet connectors -----------------------------------------------------
# Injected wallets and Coinbase Wallet work with no configuration. WalletConnect
# is only offered when a project id is set — get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Local infrastructure --------------------------------------------------
# Host port Postgres is published on. Must match the port in the API's
# DATABASE_URL — compose reads this, the API reads that, and nothing reconciles
# them if they drift.
POSTGRES_PORT=5435
