# Rivora API — server configuration.
#
# Unlike the web app's `NEXT_PUBLIC_` variables, nothing here reaches a
# browser. Secrets belong in this file's real counterpart (`.env`), which is
# gitignored.

# PostgreSQL connection string used by Prisma.
# The compose stack sets this for you; this default targets a local server.
DATABASE_URL=postgresql://rivora:rivora@localhost:5432/rivora?schema=public

# Port the HTTP server binds to.
PORT=4000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Serve Swagger UI at /docs. Turn off in production — the schema describes
# every mutation the protocol accepts.
SWAGGER_ENABLED=true

# --- Authentication ---------------------------------------------------------
# Signing key for session tokens. REQUIRED in production: the server refuses to
# start without one, because a shipped default is a forgeable session token for
# everyone who has read the repository. Minimum 32 characters.
#
#   openssl rand -base64 48
#
# Left unset in development, where an ephemeral key is generated per boot.
JWT_SECRET=

# Session lifetime, seconds. Short by design — tokens are stateless and cannot
# be revoked once issued, so the lifetime is what bounds the exposure.
JWT_TTL_SECONDS=3600

# Domains accepted in the `domain` field of a Sign-In With Ethereum message.
# This is what stops a signature harvested by another site being replayed here.
# Defaults to the hosts of CORS_ORIGINS.
SIWE_DOMAINS=localhost:3000

# Chain a sign-in message must target. Must match the wallet's network exactly:
# this is compared against the `Chain ID` field of every SIWE message, so a
# wrong value here rejects every real sign-in with `invalid_signature`.
ARC_CHAIN_ID=5042002

# --- Chain ------------------------------------------------------------------
# `ledger` keeps money movement in the database. `arc` broadcasts real
# transactions and requires a configured signer and the addresses below.
#
# Opt-in on purpose: turning this on moves real value, which should never be
# what happens when a variable is left unset.
CHAIN_MODE=ledger

# Deployed protocol contracts. Populate from contracts/deployments/ after
# running `pnpm --filter @rivora/contracts deploy:arc`.
CREDIT_VAULT_ADDRESS=
CREDIT_MANAGER_ADDRESS=
RISK_REGISTRY_ADDRESS=

# --- Rate limiting ----------------------------------------------------------
# Global ceiling per IP. Auth endpoints and the partner Score API apply their
# own tighter limits on top of this.
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
