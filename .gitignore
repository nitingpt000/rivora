node_modules
.pnpm-store

# build output
dist
.next
out
build
*.tsbuildinfo

# turbo
.turbo

# env
.env
.env.local
.env.*.local

# Circle entity-secret recovery files. The only way to reset an entity secret,
# and Circle does not keep a copy — committing one hands over control of every
# developer-controlled wallet.
#
# Anchored to contracts/: an unanchored `recovery/` matches any directory of
# that name, which silently excluded the borrower recovery screen's source.
/contracts/recovery/
*.dat

# Foundry
contracts/out
contracts/cache
contracts/broadcast
contracts/lib/openzeppelin-contracts

# Pitch deck build output. `deck/build.js` regenerates it from `assets/` and
# `assets.js`, so the file is a product rather than a source — and a 3 MB
# binary that changes wholesale on every rebuild is the worst thing to keep
# in a git history.
deck/*.pptx

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

# test
coverage
